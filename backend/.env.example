# Backend Environment Variables
# Copy this file to .env and fill in the values

# The port your server runs on (defaults to 3000)
PORT=3000

# Your Neon PostgreSQL database connection string
DATABASE_URL=postgres://your_neon_username:your_neon_password@your-neon-host.neon.tech/your_db_name?sslmode=require

# A secret password you choose to protect the GET /api/leads endpoint
ADMIN_PASSWORD=my_secure_kivex_password
